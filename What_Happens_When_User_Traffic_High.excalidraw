    {
      "id": "Lvi0K7AFiId4Du57OTpv4",
      "type": "text",
      "x": -1808.606069112784,
      "y": -605.6706515036558,
      "width": 945.0097031401507,
      "height": 548.9536595216651,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aO",
