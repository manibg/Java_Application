      "created": 1795326459774,
      "link": null,
      "locked": false,
      "text": "- Tomcat is the first request processing layer\n- 200 Active threads handle active requests\n- Accept Queue buffer additional connections\n- full thread + full Queue can cause connection refusal.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Tomcat is the first request processing layer\n- 200 Active threads handle active requests\n- Accept Queue buffer additional connections\n- full thread + full Queue can cause connection refusal.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
