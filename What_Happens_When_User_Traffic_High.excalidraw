    {
      "id": "MV1t4vMCecwfI9fXzUoJz",
      "type": "text",
      "x": -2069.265024797575,
      "y": -1327.7513158761706,
      "width": 810.4949984642695,
      "height": 512.9462594987051,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aD",
      "roundness": null,
      "seed": 956216667,
      "version": 1303,
      "versionNonce": 1988545126,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795328838501,
      "created": 1795248850343,
      "link": null,
      "locked": false,
      "text": "11. Support multiple payment methods. (Card, UPI, Wallet, Cash)\n\n12. Generate and strore ride history for rider and driver\n\n13. Allow ride cancellation by rider or driver.\n\n14. Handle surge pricing during high demand.\n\n15. Allow user to rate and review the ride.\n\n16. send realtime notification (ride status, driver arrival, payment, etc).\n\n17. Provide driver earnings and payout history.\n\n18. Allow support tickets and issue resolution.\n\n19. Enable admin operations (Manage users, rider, drivers and disputes, etc)\n\n20. Maintain audit logs for critical operations.",
      "fontSize": 21.59773724205074,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "11. Support multiple payment methods. (Card, UPI, Wallet, Cash)\n\n12. Generate and strore ride history for rider and driver\n\n13. Allow ride cancellation by rider or driver.\n\n14. Handle surge pricing during high demand.\n\n15. Allow user to rate and review the ride.\n\n16. send realtime notification (ride status, driver arrival, payment, etc).\n\n17. Provide driver earnings and payout history.\n\n18. Allow support tickets and issue resolution.\n\n19. Enable admin operations (Manage users, rider, drivers and disputes, etc)\n\n20. Maintain audit logs for critical operations.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
