      "link": null,
      "locked": false,
      "text": "database pressure:\n( High CPU, High I/O, Slow queries)",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "database pressure:\n( High CPU, High I/O, Slow queries)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "YwygwWBUIYQCyoxQyDCPo",
      "type": "text",
      "x": -6301.1748444628165,
      "y": 5988.33410165576,
      "width": 896.8316040039062,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2U",
      "roundness": null,
      "seed": 1049287738,
      "version": 176,
      "versionNonce": 404362042,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795331115814,
      "created": 1795330838158,
      "link": null,
      "locked": false,
      "text": "1. HikariCP can show stress before the rest of the stack",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. HikariCP can show stress before the rest of the stack",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "sS3JTPY6k0qaFsExt7DOW",
      "type": "text",
      "x": -6333.249318394295,
      "y": 5774.420090474913,
      "width": 966.8876342773438,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2V",
      "roundness": null,
      "seed": 775706214,
      "version": 137,
      "versionNonce": 1375664422,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795331074156,
      "created": 1795330847024,
      "link": null,
      "locked": false,
      "text": "2. Slow queries keep database connections occupied longer",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Slow queries keep database connections occupied longer",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "xCzYR3CFWNh8nALPjw5bR",
      "type": "text",
      "x": -6360.57575996427,
      "y": 5565.5150850655245,
      "width": 981.8635864257812,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2W",
      "roundness": null,
      "seed": 2019414502,
      "version": 162,
      "versionNonce": 571264250,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795331088356,
      "created": 1795330861402,
      "link": null,
      "locked": false,
      "text": "3. Waiting for connections consumes Tomcat worker threads",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. Waiting for connections consumes Tomcat worker threads",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "FtBKDv37XlLiP1QOnh2qT",
      "type": "text",
      "x": -6301.494747352419,
      "y": 5364.270912012473,
      "width": 785.015625,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2X",
      "roundness": null,
      "seed": 487370086,
      "version": 124,
      "versionNonce": 280589242,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795331091559,
      "created": 1795330936780,
      "link": null,
      "locked": false,
      "text": "4. Blocked threads cause the accept queue to fill",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. Blocked threads cause the accept queue to fill",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Rxq_W0dQGSnMm3y8_go9R",
      "type": "text",
      "x": -6327.920409733238,
      "y": 5159.162648792873,
      "width": 944.9276733398438,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2Y",
      "roundness": null,
      "seed": 1404662842,
      "version": 100,
      "versionNonce": 1951188474,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795331094743,
      "created": 1795330953318,
      "link": null,
      "locked": false,
      "text": "5. Full queues can lead to timeouts and connection refusal",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5. Full queues can lead to timeouts and connection refusal",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
