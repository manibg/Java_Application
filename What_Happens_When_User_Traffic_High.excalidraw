      "link": null,
      "locked": false,
      "text": "Spring boot actuator exposes HikariCP metrics such as Active and Pending connections:",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Spring boot actuator exposes HikariCP metrics such as Active and Pending connections:",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "LgAO4vWKf0gXqGm2rQ4xT",
      "type": "text",
      "x": -7045.473491908664,
      "y": 3535.5740591361982,
      "width": 1225.1875,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1J",
      "roundness": null,
      "seed": 415953786,
      "version": 320,
      "versionNonce": 1363405306,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795330380112,
      "created": 1795328910610,
      "link": null,
      "locked": false,
      "text": "Redis changing the traffic pattern:\n\n- Redis can serve frequently requested data without touching the database.\n- Cache hit reduce pressure on HikariCP and Database.\n- Cache miss still reach the DB and populate the cache.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Redis changing the traffic pattern:\n\n- Redis can serve frequently requested data without touching the database.\n- Cache hit reduce pressure on HikariCP and Database.\n- Cache miss still reach the DB and populate the cache.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
