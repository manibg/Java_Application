    {
      "id": "Hqix49Fjf7xnINOp2Bwgx",
      "type": "text",
      "x": -2758.1623919792682,
      "y": -1382.9792722593647,
      "width": 561.6805419921875,
      "height": 619.9480236745856,
      "angle": 0,
      "strokeColor": "#1e1e1e",
