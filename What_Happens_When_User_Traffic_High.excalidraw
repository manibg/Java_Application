      "seed": 642583605,
      "version": 990,
      "versionNonce": 460955430,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795328838501,
      "created": 1795239435343,
      "link": null,
      "locked": false,
      "text": "Functional Requirement:\n\n1. User Registration and login (Rider & Driver)\n\n2. Maintain user profile (name, phone, email, etc)\n\n3. Allow rider to book a ride (now or later)\n\n4. Capture pickup and drop location using maps.\n\n5. show available nearby drivers in real time.\n\n6. Match a rider with the best available driver.\n\n7. Provide a ride details, (ETA, distance, fare estimate)\n\n8. Allow driver to accept or decline a ride request.\n\n9. Track ride in real time on the map.\n\n10. Calculate final fare based on distance, time and surge.\n\n",
      "fontSize": 21.56340951911602,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirement:\n\n1. User Registration and login (Rider & Driver)\n\n2. Maintain user profile (name, phone, email, etc)\n\n3. Allow rider to book a ride (now or later)\n\n4. Capture pickup and drop location using maps.\n\n5. show available nearby drivers in real time.\n\n6. Match a rider with the best available driver.\n\n7. Provide a ride details, (ETA, distance, fare estimate)\n\n8. Allow driver to accept or decline a ride request.\n\n9. Track ride in real time on the map.\n\n10. Calculate final fare based on distance, time and surge.\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
