    {
      "id": "vwNJipOl2NrPUApwxK13f",
      "type": "text",
      "x": -2751.743031960442,
      "y": -621.8691642013948,
      "width": 872.8342895507812,
      "height": 566.0394998767956,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aI",
      "roundness": null,
      "seed": 2024075611,
      "version": 2197,
      "versionNonce": 231278522,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795328838501,
      "created": 1795249294972,
      "link": null,
      "locked": false,
      "text": "Non-Functional Requirement:\n\n1. Scalability - Handles millions of users, and Concurrent ride requests.\n\n2. High Availability - 99.99% uptime for ride booking and Tracking.\n\n3. Low latency - <= 200 ms for critical APIs (Booking, Tracking & matching).\n\n4. Reliability - Ensure consistent ride matching and payment processing.\n\n5. Consistency - Maintain accurate ride, payment and location data across services.\n\n6. Durability - No loss of ride and payment data event during failures.\n\n7. Security - Protect user data with HTTPS, encryption and secure token-based auth.\n\n8. Privacy - Comply with data protection laws. (e.g: GDPR, DPDP)\n\n9. Performance - Efficient handling of real time location update and high read/write traffic.\n\n10. Fault Tolerance - Continue Essential services despite partial failures.",
      "fontSize": 21.56340951911602,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-Functional Requirement:\n\n1. Scalability - Handles millions of users, and Concurrent ride requests.\n\n2. High Availability - 99.99% uptime for ride booking and Tracking.\n\n3. Low latency - <= 200 ms for critical APIs (Booking, Tracking & matching).\n\n4. Reliability - Ensure consistent ride matching and payment processing.\n\n5. Consistency - Maintain accurate ride, payment and location data across services.\n\n6. Durability - No loss of ride and payment data event during failures.\n\n7. Security - Protect user data with HTTPS, encryption and secure token-based auth.\n\n8. Privacy - Comply with data protection laws. (e.g: GDPR, DPDP)\n\n9. Performance - Efficient handling of real time location update and high read/write traffic.\n\n10. Fault Tolerance - Continue Essential services despite partial failures.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
